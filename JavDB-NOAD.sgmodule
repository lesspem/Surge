#!name=JavDB (Astarte) 去广告 & 去公告
#!desc=去除 JavDB App 开屏广告、公告/請注意弹窗、首页/磁链页广告。逻辑对齐已验证的 QX 配置，MITM 覆盖全部备用域名，脚本内联无网络依赖。
#!author=lesspem
#!homepage=https://github.com/lesspem/Surge

# 必须解密所有备用 API 域名才能让脚本拿到明文 body（Surge 需安装并信任 CA）
[MITM]
hostname = apidd.spthgb.com, apidd.czssdgz.com, apidd.btyjscl.com, api.ffaoa.com, api.aliycloud.com, api.liquidlink.cn, tp.spfcas.com

# 兜底：直接拒绝广告图片 CDN 与第三方归因 SDK
[URL Rewrite]
^https?:\/\/tp\.spfcas\.com\/[^\/]+\/ads\/.*$ reject-img
^https?:\/\/api\.liquidlink\.cn\/api\/.*$ reject-dict

# 核心：内联脚本把 startup/ads 两个接口的广告与弹窗载荷删除
# 匹配任意域名（.+），覆盖全部备用 API；脚本已 base64 内联，单文件即可分发
[Script]
javdb_ad_remover = type=http-response, pattern=^https?:\/\/.+\/api\/v\d+\/(ads|startup), requires-body=1, max-size=-1, script-
