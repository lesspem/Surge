#!name=JavDB (Astarte) 去广告
#!desc=基于 Quantumult X 抓包分析，屏蔽 JavDB App 开屏广告与首页/磁链广告位（Surge 单文件模块，脚本已内联）
#!author=lesspem
#!homepage=https://github.com/lesspem/Surge

# 让 Surge 能解密并改写 HTTPS 响应体（必须在系统/Surge 里安装并信任 CA）
[MITM]
hostname = apidd.spthgb.com

# 兜底：直接拒绝广告图片 CDN 路径与第三方广告/归因 SDK
# （tp.spfcas.com 也承载真实封面，故只拦 /ads/ 子路径）
[URL Rewrite]
^https://tp\.spfcas\.com/rhe951l4q/ads/.*$ reject
^https://api\.liquidlink\.cn/.*$ reject

# 核心：用内联脚本把两个广告接口的广告载荷清零
# 不拒绝接口（App 启动还需 backup_domains/settings 等数据），只置空广告
# 脚本已 base64 内联，无需额外文件，单文件即可分发安装
[Script]
javdb_ad_remover = type=http-response, pattern=^https?:\/\/apidd\.spthgb\.com\/api\/v1\/(ads|startup), requires-body=1, max-size=-1, script-
