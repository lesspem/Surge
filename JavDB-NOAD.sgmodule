#!name=JavDB (Astarte) 去广告
#!desc=屏蔽 JavDB App 启动广告、公告弹窗、請注意弹窗、首页顶部轮播广告、磁链页广告（Surge 模块，脚本外链托管于仓库 javdb_ad_remover.js）
#!author=lesspem
#!homepage=https://github.com/lesspem/Surge

# 让 Surge 能解密并改写 HTTPS 响应体（必须在系统/Surge 里安装并信任 CA，且打开 MitM 开关）
[MITM]
hostname = apidd.spthgb.com

# 兜底：直接拒绝广告图片 CDN 路径与第三方广告/归因 SDK
# （tp.spfcas.com 也承载真实封面，故只拦 /ads/ 子路径）
[URL Rewrite]
^https://tp\.spfcas\.com/rhe951l4q/ads/.*$ reject
^https://api\.liquidlink\.cn/.*$ reject

# 核心：用外链脚本把广告/弹窗接口的相关载荷清空
# 脚本托管在仓库同目录 javdb_ad_remover.js（外链方式，避免 base64 解码兼容问题）
[Script]
javdb_ad_remover = type=http-response, pattern=^https?:\/\/apidd\.spthgb\.com\/api\/v\d+\/(ads|startup), requires-body=1, max-size=-1, script-path=https://raw.githubusercontent.com/lesspem/Surge/main/javdb_ad_remover.js
